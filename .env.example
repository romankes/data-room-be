POSTGRES_DB=data_room
POSTGRES_USER=data_room
POSTGRES_PASSWORD=data_room
POSTGRES_PORT=5433

DATABASE_URL=postgresql://data_room:data_room@localhost:5433/data_room?schema=public

# Comma-separated frontend origins allowed to send browser requests
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Private Cloudflare R2 bucket credentials (S3 API token)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=data-room-files

# Defaults: 50 MiB PDFs and 15-minute presigned URLs
MAX_PDF_SIZE_BYTES=52428800
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=900
