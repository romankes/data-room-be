generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ShareMode {
  PUBLIC
  AUTHORIZED
}

enum ShareTargetType {
  ALL
  FOLDER
  FILE
}

model User {
  id           String  @id @default(uuid()) @db.Uuid()
  email        String  @unique
  passwordHash String?

  folders Folder[]
  files   File[]

  ownedShares Share[] @relation("ShareOwner")

  sharedAccess ShareRecipient[]
}

model Folder {
  id   String @id @default(uuid()) @db.Uuid()
  name String

  userId String @db.Uuid()
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId String? @db.Uuid()
  folder   Folder? @relation("FolderHierarchy", fields: [folderId], references: [id], onDelete: Cascade)

  folders Folder[] @relation("FolderHierarchy")
  files   File[]

  shares Share[]

  @@index([userId])
  @@index([folderId])
}

model File {
  id         String   @id @default(uuid()) @db.Uuid()
  name       String
  storageKey String?  @unique
  mimeType   String   @default("application/pdf")
  size       Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  userId String @db.Uuid()
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId String? @db.Uuid()
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  shares Share[]

  @@index([userId])
  @@index([folderId])
}

model Share {
  id String @id @default(uuid()) @db.Uuid()

  mode       ShareMode
  targetType ShareTargetType

  // User who created the share
  ownerId String @db.Uuid()
  owner   User   @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // =========================
  // Target
  // =========================

  // targetType = FOLDER
  folderId String? @db.Uuid()
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  // targetType = FILE
  fileId String? @db.Uuid()
  file   File?   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // targetType = ALL:
  // folderId = null
  // fileId   = null
  //
  // In this case access applies to all
  // folders/files owned by ownerId.

  // =========================
  // Public sharing
  // =========================

  // Only used when mode = PUBLIC
  // Store hash instead of raw token
  publicTokenHash String? @unique

  // =========================
  // Authorized sharing
  // =========================

  // Only used when mode = AUTHORIZED
  recipients ShareRecipient[]

  // =========================
  // Lifecycle
  // =========================

  createdAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime?

  @@index([ownerId])
  @@index([folderId])
  @@index([fileId])
  // Common access checks
  @@index([ownerId, targetType, revokedAt])
}

model ShareRecipient {
  shareId String  @db.Uuid()
  email   String
  userId  String? @db.Uuid()

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

  // Set for users who were registered when the share was created. Email is
  // still the access identity so pending recipients work after registration.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Allows revoking access for one specific recipient
  // without revoking the entire Share
  revokedAt DateTime?

  @@id([shareId, email])
  @@index([userId])
  @@index([userId, revokedAt])
  @@index([email, revokedAt])
}
